# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
# The root rule misses android/build, which Gradle writes reports into.
**/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Deployment
.vercel

# Local agent/tool state — machine-specific, not part of the project
.claude-flow/
.claude/.mcp.json
.claude/proven-config.json
.claude/.proven-config-version

# Golden-test diff output, written only when a golden fails
**/failures/

# Scratch output from browser and design tooling
.playwright-mcp/
.stitch/

# Backup copies left behind by doc-rewriting tooling
*.original.md

# Golden images rendered by tests
test/**/*.png
